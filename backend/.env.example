APP_NAME="Yash Technology Outreach Hub"
APP_ENV="development"
DATABASE_URL="postgresql+psycopg://postgres:root@localhost:5432/yash_outreach"
CORS_ORIGINS="http://localhost:8501,http://localhost:3000"
FRONTEND_BASE_URL="http://localhost:8501"
DEFAULT_DAILY_SEND_LIMIT="30"
WRITE_API_KEY="change-me"

# Phase 2 discovery
APOLLO_BASE_URL="https://api.apollo.io/api/v1"
APOLLO_API_KEY=""
APOLLO_DAILY_CALL_LIMIT="500"
APOLLO_MAX_COMPANIES_PER_RUN="50"
APOLLO_MAX_CONTACTS_PER_COMPANY="10"
APOLLO_MIN_SECONDS_BETWEEN_CALLS="1.0"
APOLLO_RETRY_LIMIT="3"
DISCOVERY_ENABLED_PROVIDERS="apollo"
DISCOVERY_SCHEDULE_HOUR_UTC="2"
DISCOVERY_SCHEDULE_MINUTE_UTC="0"
ENABLE_AUTOMATION_SCHEDULER="false"

# Phase 2+ enrichment
HUNTER_API_KEY=""

# Phase 3+
OPENAI_API_KEY=""
OPENAI_DRAFT_MODEL="gpt-4.1-mini"
ANTHROPIC_API_KEY=""

# Mailboxes / sending creds
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Future jobs / queues
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"
